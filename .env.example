APP_ENV=local
PORT=8080
LTM_DATABASE_PATH=.data/ltm-local.sqlite
LTM_AUTH_MODE=local-synthetic-only
LTM_PROVIDER_MODE=fail-closed
# Optional original-image content store for local/test only. Never enabled as a production fallback.
# LTM_TIMELINE_MEDIA_DIRECTORY=/absolute/task-owned/timeline-images
DATABASE_URL=postgresql://ltm:ltm_local@localhost:5432/ltm
# Production API and workers use the distributed profile and a TLS-verifying URL.
# LTM_DEPLOYMENT_PROFILE=distributed
# DATABASE_URL=postgresql://ltm_runtime@db.example.com/ltm?sslmode=verify-full
# LTM_POSTGRES_WORKER_APPLICATION_NAME=ltm-worker
# LTM_POSTGRES_WORKER_POOL_MAX=5
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ltm-local

# Production identity (uncomment only with a real HTTPS OIDC issuer/JWKS).
# LTM_AUTH_MODE=oidc
# LTM_OIDC_ISSUER=https://identity.example.com/
# LTM_OIDC_AUDIENCE=ltm-api
# LTM_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# LTM_OIDC_ALGORITHMS=RS256,ES256
# LTM_OIDC_TOKEN_TYP=at+jwt
# LTM_OIDC_MAX_TOKEN_AGE_SECONDS=900
# LTM_OIDC_ROLE_MAP_JSON={"ltm-consumer":"consumer","ltm-platform-admin":"platform_admin"}
# LTM_OIDC_STEP_UP_ACR_VALUES=urn:ltm:acr:mfa

# Production evidence verification uses public keys only. Private signing keys
# belong in the isolated integration gateway's managed secret account.
# B127 keys use a dedicated release-control identity, one exact ltm-evidence:v1
# scope, and the reserved b127-production-release-authority role. Never assign
# that role or B127 scope to integration-gateway/direct/supply callback keys.
# LTM_EVIDENCE_TRUST_KEYS_JSON=[{"issuer":"production-release-authority","provider":"release-control:provider-id","keyId":"key-2026-01","algorithm":"Ed25519","publicKeyPem":"PUBLIC-KEY-PEM","allowedScopes":["ltm-evidence:v1:64-lowercase-hex-digest"],"allowedEnvironments":["production"],"authorityRoles":["b127-production-release-authority"]}]
# LTM_METRICS_TOKEN_SHA256=64-lowercase-hex-digest

# Production release certification uses a separate SELECT-only PostgreSQL role.
# Its URL must use sslmode=verify-full; SQLite is accepted only by local/test runs.
# LTM_B127_SOURCE=postgresql
# LTM_B127_POSTGRES_URL=postgresql://ltm_b127_reader@db.example.com/ltm?sslmode=verify-full
# LTM_RELEASE_MANIFEST_PATH=/immutable-release/release-manifest.json
# LTM_TRUSTED_EVIDENCE_KEYS_FILE=/immutable-release/trusted-evidence-keys.json
# LTM_RELEASE_TENANT_ID=tenant-production
# LTM_RELEASE_LAUNCH_ID=launch-production-identifier
# LTM_DEPLOYMENT_EVIDENCE_PATH=/immutable-release/deployment-evidence.json

# Production worker. These JSON objects contain configuration and managed-secret
# references only; never put the referenced HMAC values in an environment file.
# LTM_WORKER_MODE=external
# LTM_WORKER_TENANT_ID=tenant-production
# LTM_WORKER_ACTOR_ID=ltm-production-worker
# LTM_WORKER_ID=ltm-outbox-worker-1
# LTM_WORKER_HEALTH_PORT=8090
# LTM_EXTERNAL_COMMAND_ADAPTERS_JSON={"B05":{"endpoint":"https://provider.example.com/ltm/commands","signingSecretReference":"secret-manager:ltm/production/provider-hmac","responseVerificationKeyReference":"secret-manager:ltm/production/provider-response-key","responseSignatureScheme":"hmac-sha256"}}
# LTM_OUTBOX_ROUTE_ADAPTERS_JSON={"integration":{"endpoint":"https://events.example.com/ltm/integration","signingSecretReference":"secret-manager:ltm/production/events-hmac","responseVerificationKeyReference":"secret-manager:ltm/production/events-response-key","responseSignatureScheme":"ed25519"}}

# Provider callback/evidence gateway. Deploy this separately with a fixed tenant
# and a short-lived projected OIDC token whose API principal has external-event:apply.
# LTM_TENANT_ID=tenant-production
# LTM_REDIS_URL=rediss://redis.internal.example.com:6380/0
# LTM_EVIDENCE_S3_BUCKET=ltm-production-evidence
# LTM_EVIDENCE_S3_PREFIX=ltm/provider-evidence
# LTM_EVIDENCE_S3_KMS_KEY_ID=arn:aws:kms:region:account:key/key-id
# LTM_EVIDENCE_ISSUER=prod:integration-gateway
# LTM_EVIDENCE_KEY_ID=evidence-key-2026-01
# LTM_EVIDENCE_PRIVATE_KEY_REFERENCE=secret-manager:ltm/production/evidence-ed25519
# LTM_API_COMMAND_URL=https://api.example.com/v1/commands
# LTM_API_BEARER_TOKEN_FILE=/var/run/secrets/ltm/gateway-oidc-token
# LTM_API_EVIDENCE_PURPOSE=external_business_event_projection
# LTM_COMMERCE_BINDING_URL=https://commerce.example.com/v1/evidence-bindings
# LTM_COMMERCE_BINDING_SIGNING_KEY_REFERENCE=secret-manager:ltm/production/commerce-request-hmac
# LTM_COMMERCE_BINDING_RESPONSE_KEY_REFERENCE=secret-manager:ltm/production/commerce-response-key
# LTM_COMMERCE_BINDING_RESPONSE_SIGNATURE_SCHEME=ed25519
# LTM_APPLE_CALLBACKS_ENABLED=true
# LTM_APPLE_BUNDLE_ID=com.example.ailifetime
# LTM_APPLE_APP_ID=1234567890
# LTM_APPLE_ROOT_CERTIFICATE_REFERENCES=secret-manager:ltm/production/apple-root
# LTM_APPLE_ONLINE_CERTIFICATE_CHECKS=true
# LTM_GOOGLE_CALLBACKS_ENABLED=true
# LTM_GOOGLE_AUTH_MODE=adc
# LTM_GOOGLE_PLAY_PACKAGE_NAME=com.example.ailifetime
# LTM_GOOGLE_PUBSUB_AUDIENCE=https://gateway.example.com/v1/callbacks/google-play
# LTM_GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=push@example-project.iam.gserviceaccount.com
# LTM_GOOGLE_PUBSUB_SUBSCRIPTION=projects/example-project/subscriptions/ltm-google-play
# LTM_WECHAT_CALLBACKS_ENABLED=true
# LTM_WECHAT_MERCHANT_ID=merchant-id
# LTM_WECHAT_API_V3_KEY_REFERENCE=secret-manager:ltm/production/wechat-api-v3
# LTM_WECHAT_PLATFORM_KEY_MAP_REFERENCE=secret-manager:ltm/production/wechat-platform-key-map
# LTM_PARTNER_WEBHOOK_POLICIES_REFERENCE=secret-manager:ltm/production/partner-webhook-policies
# LTM_SUPPLY_EVENT_AUTHORITIES_REFERENCE=secret-manager:ltm/production/supply-event-authorities
# LTM_DIRECT_EVIDENCE_AUTHORITIES_REFERENCE=secret-manager:ltm/production/direct-evidence-authorities

# Real payment, messaging, AI, app-store and vendor secrets belong in a secret manager, never this file.

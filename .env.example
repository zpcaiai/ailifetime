APP_ENV=local
PORT=8080
LTM_DATABASE_PATH=.data/ltm-local.sqlite
LTM_AUTH_MODE=local-synthetic-only
LTM_PROVIDER_MODE=fail-closed
DATABASE_URL=postgresql://ltm:ltm_local@localhost:5432/ltm
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ltm-local
# Real payment, messaging, AI, app-store and vendor secrets belong in a secret manager, never this file.

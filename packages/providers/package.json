{
  "name": "@ltm/providers",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@aws-sdk/client-s3": "3.1114.0",
    "@aws-sdk/client-secrets-manager": "3.1114.0",
    "@ltm/core": "workspace:*",
    "google-auth-library": "11.0.2",
    "redis": "6.2.1"
  }
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "regions": ["sin1"],
  "functions": { "api/index.mjs": { "maxDuration": 300 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [{ "path": "/internal/media-cleanup", "schedule": "15 11 * * *" }]
}

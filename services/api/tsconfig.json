{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    { "path": "../../packages/core" },
    { "path": "../../packages/capabilities" },
    { "path": "../commerce-platform" },
    { "path": "../data-intelligence" },
    { "path": "../growth-operations-platform" },
    { "path": "../orchestration-platform" },
    { "path": "../partner-channel-platform" }
  ]
}

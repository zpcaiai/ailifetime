{
  "name": "@ltm/api",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist",
    "openapi.yaml"
  ],
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@ltm/capabilities": "workspace:*",
    "@ltm/core": "workspace:*",
    "jose": "6.2.9"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConsentRecord",
  "type": "object",
  "required": [
    "subject_id",
    "purpose",
    "policy_revision",
    "granted_at",
    "status",
    "evidence_ref"
  ],
  "properties": {
    "subject_id": {
      "type": "string"
    },
    "purpose": {
      "enum": [
        "portrait_generation",
        "third_party_processing",
        "share_public",
        "minor_guardian"
      ]
    },
    "policy_revision": {
      "type": "string"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "GRANTED",
        "REVOKED"
      ]
    },
    "evidence_ref": {
      "type": "string"
    },
    "guardian_evidence_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}

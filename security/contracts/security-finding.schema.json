{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-life-time-machine.example/contracts/security-finding.v1.schema.json",
  "title": "Security finding lifecycle record",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "severity", "source", "sourceFindingKey", "ownerId", "detectedAt", "dueAt", "status", "disclosureAssessment", "events"],
  "properties": {
    "version": { "const": "ltm.security-finding.v1" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "source": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sourceFindingKey": { "type": "string", "minLength": 1, "maxLength": 300 },
    "ownerId": { "$ref": "#/$defs/id" },
    "detectedAt": { "$ref": "#/$defs/timestamp" },
    "dueAt": { "$ref": "#/$defs/timestamp" },
    "status": { "enum": ["new", "triaged", "remediation_in_progress", "ready_for_retest", "risk_accepted", "false_positive", "closed"] },
    "disclosureAssessment": { "type": "object" },
    "exception": { "type": "object" },
    "events": { "type": "array", "minItems": 1, "items": { "type": "object" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}

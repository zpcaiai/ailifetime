{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-life-time-machine.example/contracts/rollout-monitoring-result.v1.schema.json",
  "title": "B127 raw monitoring result",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "resultId", "queryId", "queryArtifactSha256", "releaseId", "tenantId", "launchId", "deploymentId", "repositoryCommit", "componentSetSha256", "guardrailPolicySha256", "wave", "domain", "signalId", "unit", "windowStart", "windowEnd", "observedValue", "sampleCount", "threshold", "status", "producedAt"],
  "properties": {
    "schemaVersion": { "const": "ltm.rollout-monitoring-result.v1" }, "resultId": { "$ref": "#/$defs/id" }, "queryId": { "$ref": "#/$defs/id" }, "queryArtifactSha256": { "$ref": "#/$defs/sha256" },
    "releaseId": { "$ref": "#/$defs/id" }, "tenantId": { "$ref": "#/$defs/id" }, "launchId": { "$ref": "#/$defs/id" }, "deploymentId": { "$ref": "#/$defs/id" }, "repositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$" }, "componentSetSha256": { "$ref": "#/$defs/sha256" }, "guardrailPolicySha256": { "$ref": "#/$defs/sha256" },
    "wave": { "$ref": "#/$defs/id" }, "domain": { "$ref": "#/$defs/id" }, "signalId": { "$ref": "#/$defs/id" }, "unit": { "enum": ["ratio", "count", "minor_currency"] }, "windowStart": { "type": "string", "format": "date-time" }, "windowEnd": { "type": "string", "format": "date-time" },
    "observedValue": { "type": "number", "minimum": 0, "maximum": 1000000000000 }, "sampleCount": { "type": "integer", "minimum": 1 }, "threshold": { "type": "number", "minimum": 0, "maximum": 1000000000000 }, "status": { "const": "complete" }, "producedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": { "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}

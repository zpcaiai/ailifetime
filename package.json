{
  "name": "ai-life-time-machine-project",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint && node tools/verify-source.mjs",
    "test": "pnpm -r --if-present run test && pnpm run test:sdk-python && pnpm run test:sdk-java",
    "test:sdk-python": "PYTHONPATH=packages/sdk-python/src python3 -m unittest discover -s packages/sdk-python/tests -v",
    "test:sdk-java": "mkdir -p packages/sdk-java/build/classes && javac -d packages/sdk-java/build/classes $(find packages/sdk-java/src/main/java -name '*.java' -print)",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "APP_ENV=local LTM_AUTH_MODE=local-synthetic-only PORT=8080 pnpm --filter @ltm/api run dev",
    "start": "pnpm --filter @ltm/api run start",
    "start:local": "APP_ENV=local LTM_AUTH_MODE=local-synthetic-only PORT=8080 pnpm --filter @ltm/api run start",
    "smoke": "node tools/smoke.mjs",
    "factory:status": "python3 .ai-life-time-machine/skill-package/scripts/projectctl.py --repo . status",
    "factory:ready": "python3 .ai-life-time-machine/skill-package/scripts/projectctl.py --repo . ready",
    "factory:validate": "python3 .ai-life-time-machine/skill-package/scripts/validate_package.py --root .ai-life-time-machine/skill-package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

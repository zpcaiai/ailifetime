{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation job",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "actor_id",
    "project_id",
    "state",
    "request_fingerprint",
    "workflow_id",
    "policy_version",
    "consent_refs",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "preflight",
        "running",
        "quality-review",
        "ready",
        "partial",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "request_fingerprint": {
      "type": "string"
    },
    "workflow_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "consent_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "timeline_ages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 120
      }
    },
    "provider_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost_reservation_minor": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

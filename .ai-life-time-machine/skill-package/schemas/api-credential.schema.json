{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Partner API credential metadata",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "principal_id",
    "credential_type",
    "scopes",
    "status",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "principal_id": {
      "type": "string"
    },
    "credential_type": {
      "enum": [
        "api-key",
        "oauth-client",
        "service-account"
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "active",
        "rotating",
        "revoked",
        "expired"
      ]
    },
    "secret_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}

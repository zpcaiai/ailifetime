page { background: #f7f3ec; color: #26384a; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 14px; line-height: 1.6; }
view, button, input { box-sizing: border-box; }
.page {
  width: 100%; max-width: 720px; margin: 0 auto;
  padding: 16px 18px 32px;
  padding-left: calc(18px + env(safe-area-inset-left));
  padding-right: calc(18px + env(safe-area-inset-right));
  padding-bottom: calc(32px + env(safe-area-inset-bottom));
  overflow-wrap: anywhere;
}
.page-header { padding: 10px 2px 17px; }
.eyebrow { margin-bottom: 7px; color: #8f6744; font-size: 11px; font-weight: 600; letter-spacing: 2px; }
.title { margin: 0 0 8px; font-size: 21px; font-weight: 650; line-height: 1.35; letter-spacing: 0.5px; }
.page-title { margin-bottom: 8px; font-family: "Songti SC", "STSong", serif; font-size: 26px; line-height: 1.35; font-weight: 700; }
.muted { color: #746e66; font-size: 13px; line-height: 1.75; }
.card { margin-bottom: 12px; padding: 16px; border: 0.5px solid #e9e2d7; border-radius: 14px; background: #fffdfa; box-shadow: 0 4px 16px rgba(57, 45, 29, .035); }
.section-head { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 12px; }
.section-title { font-size: 16px; font-weight: 650; line-height: 1.4; }
.section-index { color: #8f6744; font-family: Georgia, serif; font-size: 14px; margin-right: 8px; }
.button { display: block; width: 100%; min-height: 44px; margin: 13px 0 0; padding: 10px 14px; border: 0.5px solid transparent; border-radius: 24px; background: #26384a; color: #fffdfa; font-size: 14px; font-weight: 600; line-height: 1.8; letter-spacing: 0.5px; }
.button::after { border: 0; }
.button:active { opacity: .82; }
.button[disabled] { background: #aab1b6; color: #fffdfa; border-color: transparent; }
.button.secondary { background: #f2eee6; border-color: #e5dccd; color: #374554; }
.button.danger { background: #fbefeb; border-color: #efd6cc; color: #8f493b; }
.button.compact { width: auto; min-width: 68px; min-height: 44px; margin: 0; padding: 8px 14px; font-size: 12.5px; }
.button.ghost { background: transparent; border-color: #d6c9b5; color: #5c5141; }
.field-label { display: block; margin-top: 14px; font-size: 13px; font-weight: 600; }
.field-hint { margin-top: 4px; color: #746e66; font-size: 12px; line-height: 1.7; }
.field { width: 100%; height: 48px; min-height: 44px; margin: 6px 0 0; padding: 10px 12px; border: 0.5px solid #ded5c7; border-radius: 9px; background: #fdfbf7; font-size: 14px; color: #26384a; }
.status { margin-top: 11px; padding: 11px 12px; border: 0.5px solid #e5dccd; border-radius: 9px; background: #f4efe5; color: #63533f; font-size: 13px; line-height: 1.7; word-break: break-word; }
.status.error, .error { background: #fbefeb; color: #8f493b; border-color: #efd6cc; }
.preview { display: block; width: 100%; height: 300px; max-height: 340px; border-radius: 8px; background: #f0ebe2; }
.row { display: flex; gap: 8px; align-items: center; }
.grow { flex: 1; min-width: 0; }
.tag { display: inline-block; padding: 3.5px 9px; border: 0.5px solid #e6d6bc; border-radius: 12px; color: #7c5b32; background: #f8f0e0; font-size: 11.5px; line-height: 1.6; }
.consent-panel { margin-top: 14px; padding: 12px; border: 0.5px solid #e8e0d3; border-radius: 10px; background: #f5f0e8; }
.consent-panel .row { align-items: flex-start; font-size: 12.5px; line-height: 1.8; }
checkbox { flex-shrink: 0; transform: scale(.82); transform-origin: left top; }
.privacy-foot { margin: 12px 4px 0; color: #746e66; font-size: 12px; line-height: 1.8; text-align: center; }
.divider { height: 0.5px; margin: 14px 0; background: #e9e1d4; }
.steps { display: flex; justify-content: space-between; gap: 6px; margin-bottom: 14px; }
.step { flex: 1; color: #746e66; font-size: 11.5px; padding-bottom: 9px; border-bottom: 1px solid #e0d8ca; }
.step.current { color: #26384a; border-bottom-color: #aa8350; font-weight: 650; }
.step-number { font-family: Georgia, serif; margin-right: 5px; color: #8f6744; }
.note { padding: 11px 0 0; color: #746e66; font-size: 12px; line-height: 1.8; }
.empty-state { padding: 28px 14px; border: 0.5px dashed #cdbfa8; border-radius: 14px; text-align: center; background: #f9f6f0; }
.empty-symbol { width: 42px; height: 42px; margin: 0 auto 12px; border: 0.5px solid #b49a70; border-radius: 50%; color: #8f6744; font-family: Georgia, serif; font-size: 22px; line-height: 40px; }
.empty-state .section-title { margin-bottom: 7px; }
.detail-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; padding: 10px 0; border-bottom: 0.5px solid #eee6d9; font-size: 13px; }
.detail-value { max-width: 65%; text-align: right; word-break: break-all; }
.caption { color: #746e66; font-size: 12px; line-height: 1.7; }

/* Layout follows the live logical window, including fold/unfold and split view.
   Native navigation and tabs own the top/bottom bars; do not duplicate them. */
button, input, navigator { box-sizing: border-box; min-height: 44px; }
button { white-space: normal; overflow-wrap: anywhere; }
.row > text, .section-head > view, .section-head > text,
.detail-row > text { min-width: 0; }
.section-head, .steps { flex-wrap: wrap; }
.step { min-width: 80px; }
.button.compact { flex-shrink: 0; }
.preview { max-height: 65vh; }

@media (max-width: 360px) {
  .card { padding: 12px; }
}

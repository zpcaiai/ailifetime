page { background: #f4f7fa; color: #172b3a; font-size: 30rpx; }
.page { padding: 32rpx; }
.card { margin-bottom: 24rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(18, 38, 58, .08); }
.title { margin: 0 0 16rpx; font-size: 42rpx; font-weight: 700; }
.muted { color: #60717f; font-size: 26rpx; line-height: 1.6; }
.button { margin-top: 24rpx; border-radius: 14rpx; background: #0b6b63; color: #fff; }
.button[disabled] { background: #9aa8b2; color: #eef2f5; }
.secondary { background: #e7f2f0; color: #0b5c55; }
.danger { background: #9b2430; color: #fff; }
.field { margin: 20rpx 0; padding: 20rpx; border: 2rpx solid #c8d3dc; border-radius: 12rpx; background: #fff; }
.status { margin-top: 20rpx; padding: 18rpx; border-radius: 12rpx; background: #eef5fa; }
.error { background: #fff0f1; color: #8b1e2b; }
.preview { width: 100%; max-height: 600rpx; border-radius: 16rpx; }
.row { display: flex; gap: 16rpx; align-items: center; }
.grow { flex: 1; }

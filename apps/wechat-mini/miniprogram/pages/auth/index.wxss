.auth-page { padding-top: 24px; }
.auth-page .page-header { text-align: center; padding-top: 12px; }
.auth-page .page-title { font-size: 24px; }
.auth-page .page-title > text { display: block; }
.login-emblem { width: 66px; height: 66px; margin: 0 auto; padding: 6px; border: 0.5px solid #cbb48d; border-radius: 50%; }
.login-emblem > view { height: 100%; border: 0.5px solid #e0d0b7; border-radius: 50%; background: #ede2cf; color: #8f6744; text-align: center; line-height: 52px; font-family: "Songti SC", serif; font-size: 23px; }
.login-promise { display: flex; gap: 11px; padding-top: 13px; font-size: 13px; }
.login-promise > text { color: #8f6744; font-family: Georgia, serif; font-size: 13px; }
.login-promise .caption { margin-top: 3px; font-size: 11.5px; }

<view class="page">
  <view class="card">
    <view class="title">微信安全登录</view>
    <view class="muted">openid 仅作为当前小程序的渠道标识。账户主体、租户和权限由服务端确认，不会在客户端自行合并。</view>
    <checkbox-group bindchange="consentChanged">
      <label class="row"><checkbox value="accepted" checked="{{accepted}}" />我已阅读隐私指引、AI 标识和人物授权说明</label>
    </checkbox-group>
    <button class="button" disabled="{{!accepted || busy}}" bindtap="login">{{busy ? '正在验证' : '同意并登录'}}</button>
    <view class="status error" wx:if="{{error}}">{{error}}</view>
  </view>
</view>

<view class="page"><view class="card">
  <view class="title">消息订阅与微信客服</view><view class="muted">订阅消息由您逐次选择；客户端不能发送消息或扩大模板范围。客服入口必须使用服务端短时授权。</view>
  <button class="button secondary" disabled="{{busy}}" bindtap="loadOffer">读取可订阅模板</button>
  <button class="button" wx:if="{{offer}}" disabled="{{busy}}" bindtap="subscribe">调用微信订阅消息授权</button>
  <button class="button secondary" disabled="{{busy}}" bindtap="customerService">打开微信客服会话</button>
  <button class="button secondary" open-type="contact">使用小程序客服组件</button>
  <view class="status" wx:if="{{stateText}}">{{stateText}}</view><view class="status error" wx:if="{{error}}">{{error}}</view>
</view></view>

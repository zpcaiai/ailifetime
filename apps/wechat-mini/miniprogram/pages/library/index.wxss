.library-page .page-header .section-head { margin-bottom: 0; }
.library-page .page-title { margin-bottom: 5px; }
.album-card { padding: 14px 12px; }
.album-card .section-title { font-size: 15px; }
.album-card .tag { flex-shrink: 0; font-size: 11px; }
.album-progress { height: 2.5px; margin-top: -4px; margin-bottom: 14px; overflow: hidden; border-radius: 2px; background: #e9e1d4; }
.album-progress > view { height: 100%; background: #a68450; border-radius: 2px; }
.photo-mat { padding: 6px 6px 0; border: 0.5px solid #e2d7c4; background: #fff; box-shadow: 0 5px 13px rgba(65, 47, 20, .055); }
.album-photo { height: 310px; border-radius: 2px; background: #eee7db; }
.photo-placeholder { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 9px; height: 250px; padding: 12px; background: #f2ece1; color: #7d694f; font-size: 13px; text-align: center; }
.placeholder-age { font-family: Georgia, serif; font-size: 55px; line-height: 1.3; color: #8f6744; }
.placeholder-age text { font-size: 15px; margin-left: 5px; }
.photo-footer { display: flex; gap: 12px; align-items: center; padding: 12px 6px; }
.photo-age { font-family: Georgia, serif; color: #26384a; font-size: 27px; line-height: 1.2; flex-shrink: 0; }
.photo-age text { font-family: -apple-system, "PingFang SC", sans-serif; font-size: 11.5px; margin-left: 4px; }
.photo-footer-copy { font-size: 13px; }
.photo-footer-copy > text { display: block; margin-top: 3px; color: #746e66; font-size: 10.5px; }
.rail-heading { display: flex; justify-content: space-between; margin: 14px 0 9px; color: #746e66; font-size: 11.5px; }
.rail-heading text:last-child { color: #8f6744; font-family: Georgia, serif; }
.age-rail { white-space: nowrap; padding-bottom: 2px; }
.age-chip { display: inline-flex; flex-direction: column; align-items: center; justify-content: center; vertical-align: top; width: 56px; height: 56px; margin: 0 6px 0 0; padding: 6px 2px; border: 0.5px solid #e0d6c5; border-radius: 9px; background: #f8f4ec; color: #5d554b; line-height: 1.3; font-family: Georgia, serif; font-size: 16px; }
.age-chip { white-space: nowrap; overflow-wrap: normal; }
.age-chip::after { border: 0; }
.age-chip .age-chip-label { display: flex; flex-direction: row; align-items: baseline; justify-content: center; flex-shrink: 0; white-space: nowrap; overflow-wrap: normal; line-height: 20px; }
.age-chip-label > text { font-family: -apple-system, "PingFang SC", sans-serif; margin-left: 2px; font-size: 10px; }
.age-chip .age-chip-state { flex-shrink: 0; margin-top: 4px; font-family: -apple-system, "PingFang SC", sans-serif; font-size: 10px; line-height: 14px; white-space: nowrap; overflow-wrap: normal; }
.age-chip.is-selected { background: #26384a; border-color: #26384a; color: #fffdfa; }.age-chip.is-selected .age-chip-state { color: #e8cf9e; }
.age-chip[disabled] { opacity: .65; }
.original-caption { margin-top: 7px; text-align: center; color: #746e66; font-size: 11.5px; }
.album-list-title { margin: 16px 2px 10px; }
.record-reference { color: #746e66; font-size: 11.5px; word-break: break-all; }
.archive-card .preview { margin-bottom: 12px; height: 180px; }
.empty-state navigator { text-align: center; }

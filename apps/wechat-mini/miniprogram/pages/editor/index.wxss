.field { width: auto; }
.age-focus { display: flex; align-items: baseline; gap: 8px; padding: 11px 0; color: #8f6744; }
.age-input { width: 155px; height: 55px; padding: 0; border: 0; font-family: Georgia, serif; font-size: 35px; color: #26384a; }
.age-focus > text { font-size: 14px; }
.age-route { display: flex; align-items: center; gap: 6px; margin: 17px 0 12px; color: #8f6744; font-family: Georgia, serif; font-size: 15px; }
.age-route > view { flex: 1; height: 0.5px; background: #c9b58f; }
.field { width: 100%; }
.choice-row { display: flex; gap: 8px; margin-top: 12px; }
.choice { flex: 1; min-width: 0; min-height: 48px; margin: 0; padding: 11px 6px; border: 0.5px solid #ded5c7; border-radius: 8px; background: #faf7f1; color: #746e66; font-size: 14px; line-height: 1.5; }
.choice::after { border: 0; }
.choice.selected { border-color: #26384a; color: #26384a; background: #edf0ef; font-weight: 600; }
.choice text { display: block; font-size: 11px; font-weight: 400; margin-top: 4px; }

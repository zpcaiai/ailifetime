.job-card { text-align: center; padding-top: 18px; }
.job-orbit { position: relative; width: 150px; height: 150px; margin: 0 auto 15px; border: 0.5px solid #cab58f; border-radius: 50%; padding: 12px; }
.job-orbit-inner { display: flex; flex-direction: column; justify-content: center; height: 100%; border: 0.5px dashed #d5c6aa; border-radius: 50%; background: #f6efe3; }
.job-symbol { color: #8f6744; font-size: 56px; font-family: Georgia, serif; line-height: 1.2; }
.job-orbit-caption { color: #8f6744; font-size: 8.5px; letter-spacing: 1.5px; }
.orbit-start, .orbit-end { position: absolute; top: 67px; padding: 0 3px; background: #fffdfa; color: #8f6744; font-family: Georgia, serif; font-size: 11.5px; }
.orbit-start { left: -4px; }.orbit-end { right: -9px; }
.job-title { margin-top: 11px; }
.job-description { margin-top: 9px; font-size: 12px; }
.job-track { padding: 14px 5px 3px; text-align: left; }
.job-track > view { display: flex; align-items: center; gap: 10px; padding: 7px 0; font-size: 12.5px; color: #746e66; }
.track-dot { width: 7px; height: 7px; border: 0.5px solid #bba47d; border-radius: 50%; flex-shrink: 0; }
.track-dot.filled { background: #aa8350; }

{
  "name": "@ltm/mobile-native",
  "version": "2.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "config:public": "expo config --type public",
    "bundle:android": "expo export --platform android --output-dir .artifacts/android",
    "bundle:ios": "expo export --platform ios --output-dir .artifacts/ios",
    "release:gate": "node tools/release-gate.mjs",
    "test": "node --import tsx --test src/**/*.test.ts tools/*.test.mjs",
    "quality": "npm run typecheck && npm test && npm run config:public"
  },
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@infinitered/react-native-mlkit-face-detection": "^5.0.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "base64-js": "^1.5.1",
    "expo": "~57.0.17",
    "expo-application": "~57.0.2",
    "expo-auth-session": "~57.0.10",
    "expo-background-task": "~57.0.14",
    "expo-build-properties": "~57.0.15",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-iap": "^5.4.0",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.14",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.2",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "expo-updates": "~57.0.18",
    "expo-video": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.13",
    "jpeg-js": "^0.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-ssl-public-key-pinning": "^1.2.6",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.7",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "^57.0.9",
    "expo-doctor": "^1.20.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}

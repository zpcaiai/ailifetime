# 一生拾忆时光机 · 微信小程序 (mp-weixin) & 小红书小程序 (mp-xhs) 生产环境提审配置模板
# 复制为 .env.production 并在打包提审前注入已备案的 HTTPS 域名与官方小程序 AppID

# 关闭本地沙箱模式，启用生产 HTTPS 强校验门控 (PRODUCTION_API_ORIGIN_INVALID 防护)
VITE_SANDBOX_MODE=false

# 已完成 ICP 备案并配置于微信公众平台 / 小红书开放平台服务器域名白名单的 HTTPS 网关
VITE_API_BASE_URL=https://api.ailifetime.cn

# 微信小程序正式 AppID (18位，wx开头 + 16位十六进制)
VITE_WECHAT_MINI_APPID=wx0000000000000000

# 小红书小程序正式 AppID (小红书开放平台分配)
VITE_XHS_MINI_APPID=xhs_prod_appid_placeholder

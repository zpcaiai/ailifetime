{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedLayout",
  "type": "object",
  "required": [
    "canvas",
    "safe_margin",
    "elements"
  ],
  "properties": {
    "canvas": {
      "enum": [
        "3:4",
        "9:16",
        "1:1"
      ]
    },
    "safe_margin": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 0.2
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "x",
          "y",
          "w",
          "h"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "image",
              "text",
              "qr",
              "shape",
              "ai_label"
            ]
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "field": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

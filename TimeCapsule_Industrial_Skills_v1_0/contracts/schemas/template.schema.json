{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://timecapsule.example/schema/template/v1",
  "title": "TemplateManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "name",
    "version",
    "fields",
    "image_slots",
    "sizes",
    "ai_mode",
    "label_policy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "category": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "text",
              "date",
              "enum",
              "url",
              "boolean",
              "number"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "image_slots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "sizes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "3:4",
          "9:16",
          "1:1"
        ]
      }
    },
    "ai_mode": {
      "enum": [
        "none",
        "portrait_style",
        "age_simulation",
        "restoration",
        "composite"
      ]
    },
    "label_policy": {
      "enum": [
        "ai_required",
        "conditional"
      ]
    }
  }
}
